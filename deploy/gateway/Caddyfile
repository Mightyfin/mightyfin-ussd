{
	admin off
	auto_https off
}

http://:28092 {
	bind 127.0.0.1
	header {
		Cache-Control no-store
		X-Content-Type-Options nosniff
		-Server
	}
	@callback path /healthz /ussd
	handle @callback {
		request_body {
			max_size 8KB
		}
		reverse_proxy 127.0.0.1:28093 {
			transport http {
				dial_timeout 1s
				response_header_timeout 6s
			}
		}
	}
	handle {
		respond `{"error":"NOT_FOUND"}` 404
	}
}
